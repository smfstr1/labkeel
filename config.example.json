{
  "title": "My Homelab",

  "services": [
    {
      "name": "Router",
      "description": "Admin page",
      "icon": "R",
      "group": "Network",
      "url": "http://{gateway}"
    },
    {
      "name": "Media server",
      "description": "Checked over HTTP, and down if its container stops",
      "group": "Media",
      "container": "jellyfin",
      "url": "http://192.168.1.10:8096",
      "check": { "type": "http", "url": "http://127.0.0.1:8096/health", "timeout": 6 }
    },
    {
      "name": "Database",
      "description": "Only checks that the port is open",
      "group": "Apps",
      "check": { "type": "tcp", "host": "127.0.0.1", "port": 5432 }
    },
    {
      "name": "Minecraft Bedrock",
      "description": "Shows players online",
      "group": "Games",
      "container": "bedrock",
      "check": { "type": "bedrock", "port": 19132 }
    },
    {
      "name": "Backup job",
      "description": "Up while its container is running",
      "group": "Apps",
      "container": "backup",
      "check": { "type": "none" }
    }
  ],

  "files": {
    "deny": [".ssh", ".gnupg", ".aws", ".kube", ".password-store", ".env", "*.env",
             "*.pem", "*.key", "id_rsa*", "id_ed25519*", "id_ecdsa*", ".docker", ".git-credentials"],
    "hide": []
  },

  "drive_labels": {
    "S6XXNX0R123456": "Fast NVMe (bay 1)"
  }
}
